# Zima production configuration. Copy this file to .env.production, then fill
# every blank value with an instance-specific value. Do not commit that file.

# Public entry point
APP_PORT=8080
APP_PUBLIC_URL=

# API runtime
NODE_ENV=production
TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=

# Initial administrator (used only by the explicit, idempotent seed command)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Private PostgreSQL service
DB_HOST=postgres
DB_PORT=5432
DB_USER=ideal_learning
DB_PASSWORD=
DB_DATABASE=ideal_learning

# Private MinIO service. The API and worker use these credentials internally.
MINIO_ROOT_USER=ideal_learning_minio
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ideal-learning
S3_REGION=us-east-1

# Protected material processing
IMAGE_TILE_THRESHOLD_PX=4096
IMAGE_TILE_SIZE=256

# Browser sessions
SESSION_DRIVER=cookie
