# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=replace-with-a-container-app-key
APP_URL=http://localhost:3333

# Initial administrator (required to run the admin seeder; do not commit credentials)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=ideal_learning
DB_PASSWORD=ideal_learning_local_password
DB_DATABASE=ideal_learning

# CORS
CORS_ORIGIN=http://localhost:5173

# Object storage (MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ideal_learning_minio
S3_SECRET_KEY=ideal_learning_minio_local_secret
S3_BUCKET=ideal-learning
S3_REGION=us-east-1

# Session
SESSION_DRIVER=cookie

# Local-only worker configuration. Copy this file to the ignored .env.docker
# before running `docker compose up worker`.
